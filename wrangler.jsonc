{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hunter-gallery-worker",
  "main": "workers/app.js",
  "compatibility_date": "2026-02-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLECTION_CACHE",
        "class_name": "CollectionCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollectionCache"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
