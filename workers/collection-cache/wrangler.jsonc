{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gallery-collection-cache",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLECTION_CACHE",
        "class_name": "CollectionCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollectionCache"]
    }
  ]
}
