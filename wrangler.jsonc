{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hunter-gallery-worker",
  "main": "workers/app.js",
  "compatibility_date": "2026-02-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "COLLECTION_SNAPSHOTS",
      "database_name": "gallery-collection-snapshots",
      "database_id": "3a4ff108-6331-4724-9b15-f681ed5f850d",
      "migrations_dir": "d1/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLECTION_CACHE",
        "class_name": "CollectionCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CollectionCache"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
